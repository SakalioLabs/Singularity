{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "m4_provider_resumed_audit.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "schema_version",
    "audit_id",
    "generated_at",
    "source_commit",
    "profile",
    "protocol_sha256",
    "previous_blocked_audit",
    "provider",
    "probe",
    "result",
    "decision",
    "safety"
  ],
  "properties": {
    "type": {"const": "m4_provider_resumed_audit"},
    "schema_version": {"const": 1},
    "audit_id": {
      "type": "string",
      "pattern": "^m4_provider_resumed_audit_r[1-3]_20260726$"
    },
    "generated_at": {"type": "string", "format": "date-time"},
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "profile": {"const": "m4-fixed-v1"},
    "protocol_sha256": {
      "const": "378689bc96d28580b2debcccb12efb4f955de38dd031e681ace529d4f75d157d"
    },
    "previous_blocked_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "goal_was_resumed"],
      "properties": {
        "path": {
          "const": "workspace/evals/m4_provider_blocked_audit_20260725.json"
        },
        "sha256": {
          "const": "5d9a6799569f9f8c5ccd8e0a780ee792dd25d9d08e76e7b06292f4ace7ea0b64"
        },
        "goal_was_resumed": {"const": true}
      }
    },
    "previous_resumed_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "resumed_consecutive_count"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^workspace/evals/m4_provider_resumed_audit_r[1-2]_20260726\\.json$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "resumed_consecutive_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "base_url", "model"],
      "properties": {
        "name": {"const": "openai"},
        "base_url": {"const": "https://opencode.ai/zen/go/v1"},
        "model": {"const": "deepseek-v4-flash"}
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_count",
        "retry_count",
        "timeout_s",
        "minecraft_started",
        "minecraft_ports_closed_after_probe",
        "gameplay_action_count"
      ],
      "properties": {
        "attempt_count": {"const": 1},
        "retry_count": {"const": 0},
        "timeout_s": {"const": 15.0},
        "minecraft_started": {"const": false},
        "minecraft_ports_closed_after_probe": {"const": true},
        "gameplay_action_count": {"const": 0}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "elapsed_s",
        "error_type",
        "http_status",
        "credit_error_proven",
        "response_body_retained",
        "real_planner_response_count"
      ],
      "properties": {
        "ok": {"const": false},
        "elapsed_s": {"type": "number", "minimum": 0},
        "error_type": {"const": "AuthenticationError"},
        "http_status": {"const": 401},
        "credit_error_proven": {"const": true},
        "response_body_retained": {"const": false},
        "real_planner_response_count": {"const": 0}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "blocking_condition",
        "resumed_consecutive_count",
        "blocked_threshold",
        "goal_status_after_audit",
        "probe_25_authorized",
        "counts_toward_bm012_success",
        "counts_toward_capability"
      ],
      "properties": {
        "value": {"const": "resumed_external_hold_continues"},
        "blocking_condition": {
          "const": "fixed_provider_http_401_before_planner_response"
        },
        "resumed_consecutive_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "blocked_threshold": {"const": 3},
        "goal_status_after_audit": {
          "enum": ["active", "blocked"]
        },
        "probe_25_authorized": {"const": false},
        "counts_toward_bm012_success": {"const": false},
        "counts_toward_capability": {"const": false}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credential_value_retained",
        "previous_blocked_audit_modified",
        "probe_24_evidence_modified",
        "alternate_provider_substitution_used"
      ],
      "properties": {
        "credential_value_retained": {"const": false},
        "previous_blocked_audit_modified": {"const": false},
        "probe_24_evidence_modified": {"const": false},
        "alternate_provider_substitution_used": {"const": false}
      }
    }
  }
}
