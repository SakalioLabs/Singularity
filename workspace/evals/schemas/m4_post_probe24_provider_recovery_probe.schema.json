{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "m4_post_probe24_provider_recovery_probe.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "schema_version",
    "probe_id",
    "observed_at",
    "source_commit",
    "profile",
    "protocol_sha256",
    "provider",
    "request",
    "result",
    "decision",
    "safety"
  ],
  "properties": {
    "type": {
      "const": "m4_post_probe24_provider_recovery_probe"
    },
    "schema_version": {
      "const": 1
    },
    "probe_id": {
      "const": "m4_post_probe24_provider_recovery_probe_r1_20260725"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "profile": {
      "const": "m4-fixed-v1"
    },
    "protocol_sha256": {
      "const": "378689bc96d28580b2debcccb12efb4f955de38dd031e681ace529d4f75d157d"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "base_url", "model"],
      "properties": {
        "name": {"const": "openai"},
        "base_url": {"const": "https://opencode.ai/zen/go/v1"},
        "model": {"const": "deepseek-v4-flash"}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_count",
        "retry_count",
        "timeout_s",
        "max_tokens",
        "minecraft_started",
        "gameplay_action_count"
      ],
      "properties": {
        "attempt_count": {"const": 1},
        "retry_count": {"const": 0},
        "timeout_s": {"const": 15.0},
        "max_tokens": {"const": 8},
        "minecraft_started": {"const": false},
        "gameplay_action_count": {"const": 0}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "elapsed_s",
        "error_type",
        "http_status",
        "response_body_retained",
        "provider_error_code_retained",
        "probe24_credit_exhaustion_reconfirmed",
        "recovery_gate_passed"
      ],
      "properties": {
        "ok": {"const": false},
        "elapsed_s": {"type": "number", "minimum": 0},
        "error_type": {"const": "AuthenticationError"},
        "http_status": {"const": 401},
        "response_body_retained": {"const": false},
        "provider_error_code_retained": {"const": false},
        "probe24_credit_exhaustion_reconfirmed": {"const": false},
        "recovery_gate_passed": {"const": false}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "reason",
        "authorizes_probe_25",
        "counts_toward_bm012_success",
        "counts_toward_capability"
      ],
      "properties": {
        "value": {"const": "provider_recovery_not_proven"},
        "reason": {
          "const": "fixed_provider_returned_http_401_before_a_planner_response"
        },
        "authorizes_probe_25": {"const": false},
        "counts_toward_bm012_success": {"const": false},
        "counts_toward_capability": {"const": false}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credential_value_retained",
        "minecraft_ports_closed_after_probe",
        "probe_24_evidence_modified"
      ],
      "properties": {
        "credential_value_retained": {"const": false},
        "minecraft_ports_closed_after_probe": {"const": true},
        "probe_24_evidence_modified": {"const": false}
      }
    }
  }
}
